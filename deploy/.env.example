# Copy to /opt/jx/preparedhome/.env on the box (chmod 600). Never commit the real file.
# One Claude key for this app only (its own Anthropic Console workspace, with a spend limit).
ANTHROPIC_API_KEY=
VISION_MODEL=claude-sonnet-5-5
RATE_PER_IP_10MIN=12
DAILY_LIVE_LIMIT=400
DAILY_SPEND_CAP_USD=40
# Hostname for Traefik (compose reads these from the shell or a .env next to compose.yml).
# Fallback without DNS: preparedhome.<server-ip>.sslip.io
PH_HOST=preparedhome.demo.wicflow.com
PH_CERTRESOLVER=zerossl
TRAEFIK_NETWORK=n8n_default
