# Prepared Home: every variable, none filled in.
# Server: copy to .env next to this file (chmod 600), fill in, never commit.
# Local dev: the team lead keeps his own key in .env.local (gitignored).
# An empty value means "use the default" shown in the comment.

# --- Claude (one key for this app only, from its own Anthropic Console workspace) ---
ANTHROPIC_API_KEY=
# default: claude-sonnet-5-5. Change only after `npm run eval:gate` passes.
VISION_MODEL=

# --- Public-endpoint guards ---
# default: 12 live checks per IP per 10 minutes
RATE_PER_IP_10MIN=
# default: 400 live calls per day (resets at midnight Europe/Helsinki)
DAILY_LIVE_LIMIT=
# default: 40 (USD, estimated spend per day; then recorded results only)
DAILY_SPEND_CAP_USD=
# default: the server's own per-call estimate
EST_COST_PER_CALL_USD=

# --- Runtime (compose sets sensible values; override only if needed) ---
# default: 8787
PORT=
# default: stateless (stores nothing). "file" keeps homes and records in STORE_PATH.
STORE_MODE=
# default: unused in stateless mode
STORE_PATH=
# default: 1 in compose (a reverse proxy is in front)
TRUST_PROXY=
# defaults inside the image: /app/web, /app/samples, /app/cache
WEB_DIST=
SAMPLES_DIR=
CACHE_DIR=
# default: off. Set to 1 only on a dev machine to record sample results.
CACHE_WRITE=

# --- Compose (read by docker compose via --env-file .env) ---
# default: preparedhome.demo.wicflow.com (fallback without DNS: preparedhome.<server-ip>.sslip.io)
PH_HOST=
# Traefik case only. defaults: zerossl / n8n_default (check with the preflight)
PH_CERTRESOLVER=
TRAEFIK_NETWORK=
# Caddy/nginx case only. default: 8787 (published on 127.0.0.1 only)
PH_PORT=
# default: live (image tag; use "prev" to roll back)
PH_TAG=
